---
extends: default

rules:
  line-length: disable
  comments-indentation: disable
  comments:
    min-spaces-from-content: 1
  braces:
    max-spaces-inside: 1
  octal-values:
    forbid-explicit-octal: true
    forbid-implicit-octal: true
  document-start:
    ignore: |
      *.sops.yaml

ignore: |
  ansible/vars.yml
  terraform/**/.terraform/**
  kubernetes/clusters/*/flux-system/*
