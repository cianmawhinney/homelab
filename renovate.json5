{
  "configMigration": true,
  "extends": [
    "config:recommended",
    "docker:pinDigests",
    "helpers:pinGitHubActionDigests",
    ":pinDevDependencies"
  ],
  "flux": {
    "managerFilePatterns": ["/^kubernetes/.+\\.ya?ml$/"]
  },
  "packageRules": [
    {
      "description": "Don't pin the devcontainer base image to a digest",
      "matchManagers": ["dockerfile"],
      "matchPackageNames": ["mcr.microsoft.com/devcontainers/base"],
      "pinDigests": false
    },
    {
      "description": "Don't look for updates in the local dev registry, it's unreachable from Mend's hosted Renovate",
      "matchDatasources": ["docker"],
      "matchPackageNames": ["host.docker.internal:5000/**"],
      "enabled": false
    },
    {
      "description": "Group digest updates into a single weekly PR and automerge it",
      "matchUpdateTypes": ["digest"],
      "groupName": "all digests",
      "groupSlug": "all-digest",
      // Schedule the digest updates to run weekly on Sunday
      // The exact time can't be controlled as I'm using Mend's hosted Renovate
      "schedule": ["* * * * 0"],
      "automerge": true
    }
  ]
}
