{
  "configMigration": true,
  "extends": [
    "config:recommended",
    "docker:pinDigests",
    "helpers:pinGitHubActionDigests",
    ":pinDevDependencies"
  ],
  "flux": {
    "managerFilePatterns": ["/^kubernetes/.+\\.ya?ml$/"]
  },
  "packageRules": [
    {
      "description": "Group digest updates into a single weekly PR and automerge it",
      "matchUpdateTypes": ["digest"],
      "groupName": "all digests",
      "groupSlug": "all-digest",
      "schedule": ["* * * * 0"],
      "automerge": true
    }
  ]
}
